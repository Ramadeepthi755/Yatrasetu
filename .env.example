# ==============================================================================
# YatraSetu Environment Configuration Template (.env.example)
# Copy this file to .env.local (frontend) and application-local.properties/env (backend)
# DO NOT COMMIT ACTUAL SECRETS TO SOURCE CONTROL
# ==============================================================================

# System Environment
NODE_ENV=development
APP_ENV=development
APP_PORT=3000
BACKEND_PORT=8080

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Supabase (Database & Authentication)
# Replace with your Supabase Project details
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_DB_HOST=your-db-host.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-database-password-here

# Spring Boot Database Connection String (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://your-db-host.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your-database-password-here

# Google Gemini AI API Key (Server-side only)
GEMINI_API_KEY=your-gemini-api-key-here

# Razorpay Test Mode Credentials
# DO NOT expose Razorpay Secret in frontend
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_test_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret_here

# Open-Meteo Weather API (No key required for standard usage)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# OpenStreetMap / Tile Server
NEXT_PUBLIC_OSM_TILE_SERVER=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_OSM_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
